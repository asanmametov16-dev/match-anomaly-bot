# --- API ---
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_REGIONS=eu,uk          # eu, uk, us, au
ODDS_API_SPORT=soccer           # soccer_epl, soccer_uefa_champs_league и т.д. — soccer = все
ODDS_API_MARKETS=h2h,totals,spreads
FOOTBALL_DATA_KEY=              # https://www.football-data.org/client/register — пусто = не апдейтить Elo

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Расписание ---
POLL_INTERVAL_MINUTES=15        # как часто опрашивать Odds API
ELO_UPDATE_HOUR_UTC=4           # час суток (UTC), когда обновляются Elo по результатам

# --- Пороги детекторов (тюнить под себя) ---
SPREAD_THRESHOLD=0.08           # макс. относительное расхождение между букмекерами на 1X2 (8%)
DRIFT_THRESHOLD=0.15            # резкое движение относительно открытия (15%)
MODEL_GAP_THRESHOLD=0.20        # отклонение рыночного коэф. от модельного (20%)
SYNC_MOVE_THRESHOLD=0.05        # сдвиг у одного букмекера, чтобы считать его "движущимся"
SYNC_MIN_BOOKMAKERS=3           # минимум синхронно движущихся контор для алерта
EXOTIC_SPREAD_THRESHOLD=0.10    # расхождение на тоталах и форах (10%)

# --- Elo ---
ELO_K_FACTOR=20                 # скорость адаптации рейтинга
ELO_HOME_ADVANTAGE=60           # бонус хозяевам в очках Elo
ELO_DEFAULT_RATING=1500

# --- Фильтрация алертов ---
ALERT_WINDOW_HOURS=48       # алертить только матчи в ближайшие N часов
ALERT_MIN_DETECTORS=2       # минимум сработавших детекторов (без exotic_spread)

# --- Прочее ---
DB_PATH=data/anomalies.sqlite
LOG_LEVEL=INFO
